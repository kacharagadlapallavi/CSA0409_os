## 3. FCFS Disk Scheduling

c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int n,i,head,seek=0,a[20];

    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    scanf("%d",&head);

    for(i=0;i<n;i++){
        seek += abs(head-a[i]);
        head=a[i];
    }

    printf("Seek Time=%d",seek);

    return 0;
}


### Sample Output
