

## 1. File Allocation (Contiguous)
#include <stdio.h>

int main() {
    int n,f,i;
    printf("Disk blocks: ");
    scanf("%d",&n);
    printf("File size: ");
    scanf("%d",&f);

    if(f<=n) {
        printf("Allocated Blocks: ");
        for(i=0;i<f;i++)
            printf("%d ",i);
    }
    else
        printf("Allocation Failed");

    return 0;
}


### Sample Output
Disk blocks: 10
File size: 4
Allocated Blocks: 0 1 2 3

## 2. Bitmap Allocation
#include <stdio.h>

int main() {
    int n,i,b[20],req;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&b[i]);

    scanf("%d",&req);

    for(i=0;i<n && req;i++)
        if(b[i]==0){
            b[i]=1;
            req--;
        }

    for(i=0;i<n;i++)
        printf("%d ",b[i]);

    return 0;
}
