 5. File Allocation + Scheduling
#include <stdio.h>
#include <stdlib.h>

int main() {
    int f,head,i,seek=0;

    scanf("%d",&f);
    scanf("%d",&head);

    for(i=0;i<f;i++) {
        seek += abs(head-i);
        head=i;
    }

    printf("Seek Time=%d",seek);

    return 0;
}

