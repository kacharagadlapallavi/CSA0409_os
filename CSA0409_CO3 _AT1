  Q3) #include <stdio.h>
int main() {
    int n, pageTable[20];
    int pageNo, offset, pageSize;

    printf("Enter Number of Pages: ");
    scanf("%d", &n);

    printf("Enter Page Size: ");
    scanf("%d", &pageSize);

    printf("Enter Frame Numbers:\n");

    for (int i = 0; i < n; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("Enter Page Number: ");
    scanf("%d", &pageNo);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if (pageNo >= n || offset >= pageSize) {
        printf("Invalid Address\n");
    } else {
        printf("Page %d is mapped to Frame %d\n",
               pageNo, pageTable[pageNo]);

        printf("Physical Address = %d\n",
               pageTable[pageNo] * pageSize + offset);
    }

    return 0;
}
