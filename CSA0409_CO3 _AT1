Q2)  #include <stdio.h>
    int main() {
    int pageSize, pages;
    int pageTable[20];
    int pageNo, offset, physical;

    printf("Enter Page Size: ");
    scanf("%d", &pageSize);

    printf("Enter Number of Pages: ");
    scanf("%d", &pages);

    printf("Enter Frame Numbers:\n");
    for (int i = 0; i < pages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("Enter Page Number: ");
    scanf("%d", &pageNo);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if (pageNo >= pages || offset >= pageSize) {
        printf("Invalid Address\n");
    } else {
        physical = pageTable[pageNo] * pageSize + offset;
        printf("Physical Address = %d\n", physical);
    }

    return 0;
} 
